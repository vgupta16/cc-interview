{
    "openapi": "3.0.1",
    "info": {
        "title": "Api | v1",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:5080"
        }
    ],
    "paths": {
        "/health": {
            "get": {
                "tags": [
                    "System"
                ],
                "operationId": "getHealth",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/residents": {
            "get": {
                "tags": [
                    "Residents"
                ],
                "operationId": "getResidents",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Resident"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/amenities": {
            "get": {
                "tags": [
                    "Amenities"
                ],
                "operationId": "getAmenities",
                "parameters": [
                    {
                        "name": "residentId",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Amenity"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/amenities/{amenityId}/availability": {
            "get": {
                "tags": [
                    "Amenities"
                ],
                "operationId": "getAvailability",
                "parameters": [
                    {
                        "name": "amenityId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "residentId",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "date",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/SlotAvailability"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/reservations": {
            "post": {
                "tags": [
                    "Reservations"
                ],
                "operationId": "createReservation",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateReservationRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Reservation"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/reservations/{id}": {
            "delete": {
                "tags": [
                    "Reservations"
                ],
                "operationId": "cancelReservation",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "residentId",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetails"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Amenity": {
                "required": [
                    "id",
                    "buildingId",
                    "name"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "buildingId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "totalCapacity": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "reservationCapacity": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "maxSizePerReservation": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "openingHourUtc": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "closingHourUtc": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "isOpen": {
                        "type": "boolean"
                    }
                }
            },
            "CreateReservationRequest": {
                "required": [
                    "residentId",
                    "amenityId",
                    "startUtc"
                ],
                "type": "object",
                "properties": {
                    "residentId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "amenityId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "startUtc": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "size": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "ProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "nullable": true
                    },
                    "title": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "detail": {
                        "type": "string",
                        "nullable": true
                    },
                    "instance": {
                        "type": "string",
                        "nullable": true
                    }
                }
            },
            "Reservation": {
                "required": [
                    "id",
                    "amenityId",
                    "residentId",
                    "startUtc",
                    "size"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "amenityId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "residentId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "startUtc": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "size": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "endUtc": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "Resident": {
                "required": [
                    "id",
                    "buildingId",
                    "name",
                    "email",
                    "unitNumber"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "buildingId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string",
                        "nullable": true
                    },
                    "unitNumber": {
                        "type": "string"
                    }
                }
            },
            "SlotAvailability": {
                "required": [
                    "startUtc",
                    "endUtc",
                    "isAvailable"
                ],
                "type": "object",
                "properties": {
                    "startUtc": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "endUtc": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "remainingSize": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "remainingReservations": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "isAvailable": {
                        "type": "boolean"
                    },
                    "unavailableReason": {
                        "type": "string",
                        "nullable": true
                    },
                    "myReservationId": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "System"
        },
        {
            "name": "Residents"
        },
        {
            "name": "Amenities"
        },
        {
            "name": "Reservations"
        }
    ]
}
